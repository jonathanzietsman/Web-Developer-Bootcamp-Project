datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- NextAuth Schema Models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId]) // Fixed comma syntax
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  cashLogs      CashLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token]) // Fixed comma syntax
}

// --- Application Entities ---
model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String   @unique
  category    String   @default("Product") 
  costPrice   Float    @default(0.0)       
  price       Float                        
  stockQty    Float    @default(0.0)       
  unitType    String   @default("UNITS")   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model CashLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "IN" or "OUT"
  method    String   @default("CASH") // "CASH" or "CARD" <-- Add this line
  amount    Float
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Promotion {
  id               String   @id @default(cuid())
  name             String   // e.g., "2x Gummies Special"
  targetSkuPattern String   // e.g., "gummy" or "hydro"
  requiredQty      Int      // e.g., 2
  bundlePrice      Decimal  // e.g., 120.00
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}